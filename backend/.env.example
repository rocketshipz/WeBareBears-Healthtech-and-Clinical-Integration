# ==============================================================================
# MedicTri Backend Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME=MedicTri-Backend
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Azure OpenAI LLM Configuration (Main Agent)
OPENAI_API_KEY=your_azure_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4.1-mini  # Azure deployment name
OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1
OPENAI_TEMPERATURE=0.0
# /api/triage/chat: agent (LLM tool loop) or hybrid (deterministic flow, LLM only extracts and phrases)
TRIAGE_MODE=agent
# hybrid: show questions/options in everyday wording (app/tools/plain_language.json). Off until clinically reviewed.
PLAIN_LANGUAGE=false

# Google Gemini Configuration (Embedding Model Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Note: GOOGLE_API_KEY can also be used as an alternate env var name
GOOGLE_API_KEY=

# Hospital routing: Google Maps Platform key with Places API (New) and Routes API enabled (billing on).
# Without it, routing ranks by the straight-line estimate.
GOOGLE_MAPS_API_KEY=

# Database Configuration (PostgreSQL / Supabase)
# For Supabase IPv4 connection pooler (Session mode):
# POSTGRES_DB_USER=postgres.[project-ref]
# POSTGRES_DB_HOST=aws-0-[region].pooler.supabase.com (port: 5432)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=your_postgres_password
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=postgres
# Direct connection URI (overrides individual credentials if provided)
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/postgres

# Staff credentials are stored in the staff_login database table.

# Public backend origin, reachable from recipients' phones (include a proxy path prefix if needed).
# When empty, family invitation links use the incoming API request's origin.
PUBLIC_BACKEND_URL=

# Browser origins allowed to call the API (comma-separated), e.g. https://triagemy.vercel.app
# "*" allows any origin. localhost on any port is always allowed for local development.
CORS_ORIGINS=*

# Email TAC via Gmail SMTP (SSL/TLS on port 465, STARTTLS on port 587).
# Enable Google 2-Step Verification and create an App Password:
# https://support.google.com/accounts/answer/185833
TAC_DELIVERY=email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=triagemy.wbb@gmail.com
SMTP_FROM_EMAIL=triagemy.wbb@gmail.com
SMTP_PASSWORD=
# Hosts that block SMTP ports (e.g. Render free tier): send through the Brevo HTTP API instead.
# Verify SMTP_FROM_EMAIL as a sender in Brevo, create an API key, then set:
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
EMAIL_PROVIDER=smtp
# Automated tests only: TAC_DELIVERY=test and ENVIRONMENT=test/development.
# Test mode returns debug_code and never sends an email. Never use in production.
