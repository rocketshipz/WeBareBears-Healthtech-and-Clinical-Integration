{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend (Flutter)",
      "type": "dart",
      "request": "launch",
      "program": "frontend/lib/main.dart",
      "cwd": "frontend"
    },
    {
      "name": "Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Frontend)",
      "configurations": [
        "Backend (FastAPI)",
        "Frontend (Flutter)"
      ]
    }
  ]
}
